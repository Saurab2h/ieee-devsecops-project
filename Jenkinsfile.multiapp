// ============================================================
// Jenkinsfile.multiapp
//
// PURPOSE: Run the full DevSecOps pipeline on multiple apps
//          to support tool complementarity analysis (N=3).
//
// Apps:
//   1. vulnapp    — Custom Spring Boot app
//   2. dvwa       — Damn Vulnerable Web Application
//   3. juiceshop  — OWASP Juice Shop
// ============================================================

pipeline {
    agent any

    environment {
        DOCKER    = "docker"
        TRIVY     = "trivy"
        OPA       = "opa"
        ZAP_IMAGE = "ghcr.io/zaproxy/zaproxy:stable"
    }

    stages {

        stage('Prepare') {
            steps {
                sh '''
                mkdir -p results/multiapp/vulnapp
                mkdir -p results/multiapp/dvwa
                mkdir -p results/multiapp/juiceshop
                echo "Multi-app run started: $(date -u +%Y-%m-%dT%H:%M:%SZ)"

                # Fix 4: Pre-pull ZAP image once so scan stages don't re-download it
                docker pull ghcr.io/zaproxy/zaproxy:stable || true
                '''
            }
        }

        // ────────────────────────────────────────────────────────────
        // APP 1: Custom Spring Boot vulnapp (already built)
        // ────────────────────────────────────────────────────────────
        stage('Trivy: vulnapp') {
            steps {
                sh '''
                START=$(date +%s)

                $TRIVY image \
                  -f json \
                  -o results/multiapp/vulnapp/trivy-report.json \
                  vulnapp || true

                $TRIVY image \
                  --format table \
                  vulnapp > results/multiapp/vulnapp/trivy-report.txt || true

                END=$(date +%s)
                echo "vulnapp_trivy_seconds=$((END-START))" >> results/multiapp/timings.txt
                '''
            }
        }

        stage('OPA Gate: vulnapp') {
            steps {
                script {
                    sh '$DOCKER image inspect vulnapp > results/multiapp/vulnapp/image.json 2>/dev/null || true'
                    sh '''
                    $OPA eval \
                      --input results/multiapp/vulnapp/image.json \
                      --data policies/docker.rego \
                      --format raw "data.devsecops.deny" \
                      | tee results/multiapp/vulnapp/opa-config.json || true

                    $OPA eval \
                      --input results/multiapp/vulnapp/trivy-report.json \
                      --data policies/severity-gate.rego \
                      --format pretty "data.devsecops.severity.summary" \
                      | tee results/multiapp/vulnapp/opa-severity.json || true
                    '''
                }
            }
        }

        // ────────────────────────────────────────────────────────────
        // APP 2: DVWA
        // ────────────────────────────────────────────────────────────
        stage('Pull & Scan: DVWA') {
            steps {
                sh '''
                START=$(date +%s)

                $DOCKER pull vulnerables/web-dvwa:latest || true

                $TRIVY image \
                  -f json \
                  -o results/multiapp/dvwa/trivy-report.json \
                  vulnerables/web-dvwa:latest || true

                $TRIVY image \
                  --format table \
                  vulnerables/web-dvwa:latest > results/multiapp/dvwa/trivy-report.txt || true

                END=$(date +%s)
                echo "dvwa_trivy_seconds=$((END-START))" >> results/multiapp/timings.txt
                '''
            }
        }

        stage('OPA Gate: DVWA') {
            steps {
                sh '''
                $DOCKER image inspect vulnerables/web-dvwa:latest \
                  > results/multiapp/dvwa/image.json 2>/dev/null || true

                $OPA eval \
                  --input results/multiapp/dvwa/image.json \
                  --data policies/docker.rego \
                  --format raw "data.devsecops.deny" \
                  | tee results/multiapp/dvwa/opa-config.json || true

                $OPA eval \
                  --input results/multiapp/dvwa/trivy-report.json \
                  --data policies/severity-gate.rego \
                  --format pretty "data.devsecops.severity.summary" \
                  | tee results/multiapp/dvwa/opa-severity.json || true
                '''
            }
        }

        stage('ZAP DAST: DVWA') {
            steps {
                sh '''
                START=$(date +%s)

                # Fix 1: Ensure ZAP container can write reports to the mounted volume
                chmod -R 777 ${WORKSPACE}/results

                # Start DVWA container
                $DOCKER rm -f dvwa-scan-target || true
                $DOCKER run -d \
                  --name dvwa-scan-target \
                  -p 8082:80 \
                  vulnerables/web-dvwa:latest || true
                sleep 15

                # Run ZAP scan — --user root fixes Permission denied on /zap/wrk/zap-report.html
                $DOCKER run --rm \
                  --user root \
                  --network host \
                  -v ${WORKSPACE}/results/multiapp/dvwa:/zap/wrk:rw \
                  ${ZAP_IMAGE} \
                  zap-baseline.py \
                    -t http://localhost:8082 \
                    -r zap-report.html \
                    -J zap-report.json \
                    -l WARN \
                    -d || true

                $DOCKER rm -f dvwa-scan-target || true

                END=$(date +%s)
                echo "dvwa_zap_seconds=$((END-START))" >> results/multiapp/timings.txt
                '''
            }
        }

        // ────────────────────────────────────────────────────────────
        // APP 3: OWASP Juice Shop
        // ────────────────────────────────────────────────────────────
        stage('Pull & Scan: Juice Shop') {
            steps {
                sh '''
                START=$(date +%s)

                $DOCKER pull bkimminich/juice-shop:latest || true

                $TRIVY image \
                  -f json \
                  -o results/multiapp/juiceshop/trivy-report.json \
                  bkimminich/juice-shop:latest || true

                $TRIVY image \
                  --format table \
                  bkimminich/juice-shop:latest > results/multiapp/juiceshop/trivy-report.txt || true

                END=$(date +%s)
                echo "juiceshop_trivy_seconds=$((END-START))" >> results/multiapp/timings.txt
                '''
            }
        }

        stage('OPA Gate: Juice Shop') {
            steps {
                sh '''
                $DOCKER image inspect bkimminich/juice-shop:latest \
                  > results/multiapp/juiceshop/image.json 2>/dev/null || true

                $OPA eval \
                  --input results/multiapp/juiceshop/image.json \
                  --data policies/docker.rego \
                  --format raw "data.devsecops.deny" \
                  | tee results/multiapp/juiceshop/opa-config.json || true

                $OPA eval \
                  --input results/multiapp/juiceshop/trivy-report.json \
                  --data policies/severity-gate.rego \
                  --format pretty "data.devsecops.severity.summary" \
                  | tee results/multiapp/juiceshop/opa-severity.json || true
                '''
            }
        }

        stage('ZAP DAST: Juice Shop') {
            steps {
                sh '''
                START=$(date +%s)

                # Fix 1: Ensure ZAP container can write reports to the mounted volume
                chmod -R 777 ${WORKSPACE}/results

                # Start Juice Shop container
                $DOCKER rm -f juiceshop-scan-target || true
                $DOCKER run -d \
                  --name juiceshop-scan-target \
                  -p 8083:3000 \
                  bkimminich/juice-shop:latest || true
                sleep 20  # Juice Shop takes longer to start

                # Run ZAP scan — --user root fixes Permission denied on /zap/wrk/zap-report.html
                $DOCKER run --rm \
                  --user root \
                  --network host \
                  -v ${WORKSPACE}/results/multiapp/juiceshop:/zap/wrk:rw \
                  ${ZAP_IMAGE} \
                  zap-baseline.py \
                    -t http://localhost:8083 \
                    -r zap-report.html \
                    -J zap-report.json \
                    -l WARN \
                    -d || true

                $DOCKER rm -f juiceshop-scan-target || true

                END=$(date +%s)
                echo "juiceshop_zap_seconds=$((END-START))" >> results/multiapp/timings.txt
                '''
            }
        }

        // ────────────────────────────────────────────────────────────
        // Aggregate Results for Paper Table
        // ────────────────────────────────────────────────────────────
        stage('Aggregate Results') {
            steps {
                sh '''
                # ── Debug: environment diagnosis ─────────────────────────
                echo "=== ENVIRONMENT DEBUG ==="
                echo "PATH=$PATH"
                command -v jq || echo "WARNING: jq binary not found in PATH"
                jq --version 2>/dev/null || echo "WARNING: jq --version failed (not installed or not in PATH)"
                echo ""
                echo "=== FILES PRESENT ==="
                ls -lah results/multiapp/ || true
                find results/multiapp -name "*.json" 2>/dev/null || true
                echo "========================"
                echo ""

                # ── Detect jq (absolute path to avoid PATH issues) ───────
                JQ=$(command -v jq 2>/dev/null || true)
                if [ -z "$JQ" ]; then
                    echo "WARNING: jq not installed. Counts will default to 0."
                    JQ_AVAILABLE=0
                else
                    echo "jq found at: $JQ"
                    JQ_AVAILABLE=1
                fi

                # ── Helper: safely parse a jq expression ─────────────────
                # Usage: safe_jq <file> <expression>
                # Returns the numeric result, or 0 on any failure.
                safe_jq() {
                    _FILE="$1"
                    _EXPR="$2"
                    _RESULT=0
                    if [ "$JQ_AVAILABLE" = "1" ] && [ -f "$_FILE" ] && [ -s "$_FILE" ]; then
                        _OUT=$("$JQ" "$_EXPR" "$_FILE" 2>/dev/null)
                        if [ $? -eq 0 ] && [ -n "$_OUT" ]; then
                            _RESULT="$_OUT"
                        fi
                    fi
                    echo "$_RESULT"
                }

                # ── Aggregate ─────────────────────────────────────────────
                echo "=== MULTI-APP SCAN SUMMARY ===" > results/multiapp/summary.txt
                echo "Generated: $(date -u +%Y-%m-%dT%H:%M:%SZ)" >> results/multiapp/summary.txt
                echo "" >> results/multiapp/summary.txt

                for app in vulnapp dvwa juiceshop; do
                    echo "--- $app ---" >> results/multiapp/summary.txt

                    TRIVY_FILE="results/multiapp/$app/trivy-report.json"
                    OPA_FILE="results/multiapp/$app/opa-config.json"

                    if [ -f "$TRIVY_FILE" ]; then
                        CRIT=$(safe_jq "$TRIVY_FILE" \
                            '[.Results[]?.Vulnerabilities[]? | select(.Severity=="CRITICAL")] | length')
                        HIGH=$(safe_jq "$TRIVY_FILE" \
                            '[.Results[]?.Vulnerabilities[]? | select(.Severity=="HIGH")] | length')
                        MED=$(safe_jq  "$TRIVY_FILE" \
                            '[.Results[]?.Vulnerabilities[]? | select(.Severity=="MEDIUM")] | length')
                        echo "  Trivy CRITICAL=$CRIT HIGH=$HIGH MEDIUM=$MED" >> results/multiapp/summary.txt
                    else
                        echo "  Trivy report not found: $TRIVY_FILE" >> results/multiapp/summary.txt
                    fi

                    if [ -f "$OPA_FILE" ]; then
                        VIOL=$(safe_jq "$OPA_FILE" 'length // 0')
                        echo "  OPA Config Violations=$VIOL" >> results/multiapp/summary.txt
                    else
                        echo "  OPA report not found: $OPA_FILE" >> results/multiapp/summary.txt
                    fi

                    echo "" >> results/multiapp/summary.txt
                done

                cat results/multiapp/summary.txt
                '''
            }
        }
    }

    post {
        always {
            archiveArtifacts artifacts: 'results/multiapp/**', fingerprint: true
        }
    }
}
